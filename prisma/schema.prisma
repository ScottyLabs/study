generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String               @id
  name                    String
  email                   String               @unique @db.Citext
  emailVerified           Boolean              @default(false)
  directoryEligibility    DirectoryEligibility @default(UNCHECKED)
  directoryCheckedAt      DateTime?
  directoryCheckExpiresAt DateTime?
  andrewID                String?              @map("andrew_id")
  image                   String?
  academicYear            String?
  majors                  String?
  minors                  String?
  theme                   ThemePreference      @default(LIGHT)
  courseCodes             String[]             @default([])
  createdAt               DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @db.Timestamptz(3)
  accounts                Account[]
  sessions                Session[]
  memberships             GroupMembership[]
  blocksCreated           Block[]              @relation("Blocker")
  blocksReceived          Block[]              @relation("Blocked")
}

model StudyGroup {
  id          String            @id @default(uuid())
  courseCode  String
  title       String
  purpose     String
  details     String
  location    String
  startTime   DateTime          @db.Timestamptz(3)
  totalSeats  Int
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  memberships GroupMembership[]

  @@index([courseCode, startTime])
  @@index([startTime])
}

model GroupMembership {
  groupId         String
  userId          String
  calendarEventId String?
  joinedAt        DateTime   @default(now()) @db.Timestamptz(3)
  group           StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model Block {
  blockerId    String
  blockedEmail String   @db.Citext
  blockedId    String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  blocker      User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked      User?    @relation("Blocked", fields: [blockedId], references: [id], onDelete: SetNull)

  @@id([blockerId, blockedEmail])
  @@index([blockedId])
  @@index([blockedEmail])
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier, createdAt(sort: Desc)])
  @@index([expiresAt])
}

enum ThemePreference {
  LIGHT
  DARK
}

enum DirectoryEligibility {
  UNCHECKED
  ELIGIBLE
  INELIGIBLE
  UNAVAILABLE
}
